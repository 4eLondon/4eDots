<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <gap>5</gap>
    <adaptiveSync>yes</adaptiveSync>
    <reuseOutputMode>no</reuseOutputMode>
    <showMenu>no</showMenu>
    <border>2</border>
</core>

<focus>
  <followMouse>yes</followMouse>
  <followMouseRequiresMovement>yes</followMouseRequiresMovement>
  <raiseOnFocus>no</raiseOnFocus>
</focus>


  <theme>
    <cornerRadius>8</cornerRadius>
    <keepBorder>yes</keepBorder>
    <font place="ActiveWindow">
      <name>GohuFont</name>
      <size>11</size>
    </font>
    <font place="Menu">
      <name>GohuFont</name>
      <size>11</size>
    </font>
  </theme>

<desktops>
  <number>10</number>
  <names>
    <name>1</name>
    <name>2</name>
    <name>3</name>
    <name>4</name>
    <name>5</name>
    <name>6</name>
    <name>7</name>
    <name>8</name>
    <name>9</name>
    <name>10</name>
  </names>
</desktops>




  <keyboard>
      <default />

    <keybind key="W-q">
      <action name="Execute" command="foot" />
    </keybind>

    <keybind key="W-d">
        <action name="Execute" command='foot -e bash -i -c "apps"' />
    </keybind>



    <keybind key="W-c">
      <action name="Close" />
    </keybind>
    <keybind key="W-S-q">
      <action name="Exit" />
    </keybind>
    <keybind key="W-S-r">
        <action name="Reconfigure"/>
    </keybind>


    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-S-f">
      <action name="Fullscreen" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="SnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="SnapToEdge" direction="down" />
    </keybind>


    <keybind key="W-Right">
        <action name="NextWindow"/>
    </keybind>

    <keybind key="W-Left">
        <action name="PreviousWindow"/>
    </keybind>

    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
  </keybind>
    <keybind key="W-5">
      <action name="GoToDesktop" to="5" />
    </keybind>
    <keybind key="W-6">
      <action name="GoToDesktop" to="6" />
    </keybind>
    <keybind key="W-7">
      <action name="GoToDesktop" to="7" />
    </keybind>
    <keybind key="W-8">
      <action name="GoToDesktop" to="8" />
  </keybind>
    <keybind key="W-9">
      <action name="GoToDesktop" to="9" />
  </keybind>
    <keybind key="W-0">
      <action name="GoToDesktop" to="10" />
  </keybind>

    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" />
  </keybind>
    <keybind key="W-S-5">
      <action name="SendToDesktop" to="5" />
    </keybind>
    <keybind key="W-S-6">
      <action name="SendToDesktop" to="6" />
    </keybind>
    <keybind key="W-S-7">
      <action name="SendToDesktop" to="7" />
    </keybind>
    <keybind key="W-S-8">
      <action name="SendToDesktop" to="8" />
  </keybind>
    <keybind key="W-S-9">
      <action name="SendToDesktop" to="9" />
    </keybind>
    <keybind key="W-S-0">
      <action name="SendToDesktop" to="10" />
  </keybind>

    <keybind key="W-e">
      <action name="Execute" command="nemo" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="firefox" />
    </keybind>
    <keybind key="W-p">
      <action name="Execute" command="hyprpicker -a" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="grim -g &quot;$(slurp)&quot; - | wl-copy" />
    </keybind>
    <keybind key="W-Print">
      <action name="Execute" command="grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set 5%+" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>

<mouse>
    <default />
    <context name="Frame">
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
    </context>
  </mouse>


</labwc_config>
